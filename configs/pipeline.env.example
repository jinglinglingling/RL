# Copy to configs/pipeline.env and edit.
# Then run:
#   bash scripts/e2e_vlm_rl_pipeline.sh --stage all

PYTHON_BIN=python

# ---------- paths ----------
OSWORLD_SRC=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/third_party/OSWorld
NEMORL_ROOT=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/Nemo-RL-main-1/RL-merge-2689
RESULT_ROOT=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/runs/osworld-results
EXAMPLES_ROOT=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/third_party/OSWorld/evaluation_examples/examples
TRAIN_DATA=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/data/nemorl/osworld_train.jsonl
VAL_DATA=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/data/nemorl/osworld_val.jsonl
CHECKPOINT_DIR=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/outputs/checkpoints/osworld_grpo_qwen_vl
LOG_DIR=/lustre/fsw/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/linglinj/Nemo-RL-Library/osworld/outputs/logs/osworld_grpo_qwen_vl

# ---------- stage control ----------
PIPELINE_RESUME=1
PIPELINE_FORCE=0

# ---------- setup stage ----------
AUTO_CLONE_OSWORLD=0
OSWORLD_REPO_URL=https://github.com/xlang-ai/OSWorld.git
INSTALL_WORKSPACE_DEPS=1
INSTALL_OSWORLD_DEPS=1

# ---------- collect stage (OSWorld eval) ----------
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_ALIAS=gpt-4o

PROVIDER_NAME=docker
ACTION_SPACE=pyautogui
OBSERVATION_TYPE=screenshot
NUM_ENVS=1
MAX_STEPS=15
MAX_TRAJECTORY_LENGTH=3
SLEEP_AFTER_EXECUTION=3
DOMAIN=all
CLIENT_PASSWORD=password
HEADLESS=1

# Optional:
# TEST_ALL_META_PATH=evaluation_examples/test_all.json
# PATH_TO_VM=/path/to/vm.vmx
# VM_SECRET_MOUNTS=/path/local1:/path/guest1,/path/local2:/path/guest2

# ---------- convert stage ----------
VAL_RATIO=0.1
MIN_EPISODE_SCORE=1.0
INCLUDE_FAILED=0
ALLOW_MISSING_IMAGE=0
# MAX_SAMPLES=1000

# ---------- train stage ----------
# Space-separated hydra overrides passed to NeMo-RL training script.
# Example:
# NEMORL_OVERRIDES=grpo.max_num_steps=100 policy.train_global_batch_size=8
NEMORL_OVERRIDES=
