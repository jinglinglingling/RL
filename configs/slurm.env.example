SBATCH_PARTITION=interactive
SBATCH_TIME=04:00:00
GPUS_PER_NODE=1
SBATCH_CPUS_PER_TASK=16
JOB_NAME_BASE=osw-collect

PROVIDER_NAME=docker
MODEL_ALIAS=gpt-4o
DOMAIN=chrome
